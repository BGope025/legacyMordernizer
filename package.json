{
  "name": "bob-modernizer",
  "version": "1.0.0",
  "description": "Autonomous Legacy-to-Cloud Modernization Pipeline for IBM Bob 2.0 Hackathon",
  "main": "server/server.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "nodemon server/server.js",
    "dev:frontend": "cd frontend && npx vite",
    "start": "node server/server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "workspaces": [
    "server",
    "frontend"
  ],
  "devDependencies": {
    "nodemon": "^3.0.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ibm",
    "bob",
    "modernization",
    "legacy",
    "microservices"
  ],
  "author": "IBM Bob 2.0 Hackathon Team",
  "license": "MIT"
}
